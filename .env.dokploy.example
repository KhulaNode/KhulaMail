# Set these in Dokploy's Environment tab, not in Git.
APP_URL=https://mail.example.com
SESSION_SECRET=
DB_PASSWORD=
ENCRYPTION_KEY=

# Default chain: browser -> Dokploy Traefik -> frontend nginx -> backend.
TRUST_PROXY_HOPS=2
DOKPLOY_NETWORK=dokploy-network
IMAGE_CACHE_MAX_MB=512

# Optional push notifications (not enabled in the current local setup).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
