{
  "name": "B2SA Mail",
  "short_name": "B2SA Mail",
  "description": "Back2School Africa webmail",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#003b26",
  "theme_color": "#003b26",
  "orientation": "portrait-primary",
  "protocol_handlers": [
    {
      "protocol": "mailto",
      "url": "/?mailto=%s"
    }
  ],
  "icons": [
    {
      "src": "/b2sa-icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/b2sa-icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
