{
  "name": "LSTA Mail",
  "short_name": "LSTA Mail",
  "description": "Limpopo Scholar Transport Alliance webmail",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#17130f",
  "theme_color": "#17130f",
  "orientation": "portrait-primary",
  "protocol_handlers": [
    {
      "protocol": "mailto",
      "url": "/?mailto=%s"
    }
  ],
  "icons": [
    {
      "src": "/lsta-icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/lsta-icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
